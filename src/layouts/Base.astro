---
import '../styles/global.css';
import { withBase } from '../lib/url';

interface Props { title?: string; description?: string; indexed?: boolean }
const { title, description = 'A garden of Claude artifacts and the engineering vocabulary they taught me.', indexed = false } = Astro.props;
const pageTitle = title ? `${title} · artifact garden` : 'artifact garden';
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';

const tabs = [
  { href: '/', label: 'Home', match: (p: string) => p === '/' },
  { href: '/artifacts', label: 'Artifacts', match: (p: string) => p.startsWith('/artifacts') || p.startsWith('/a/') },
  { href: '/terms', label: 'Glossary', match: (p: string) => p.startsWith('/terms') },
  { href: '/review', label: 'Review', match: (p: string) => p.startsWith('/review') },
  { href: '/graph', label: 'Graph', match: (p: string) => p.startsWith('/graph') },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0f0f0f" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;700&display=swap" rel="stylesheet" />
  <script is:inline>
    try {
      const t = localStorage.getItem('ag:theme');
      if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
    } catch {}
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap bar">
      <a class="brand" href={withBase('/')}><span class="mark" aria-hidden="true"></span>artifact garden</a>
      <nav class="top-nav" aria-label="Main">
        {tabs.slice(1).map((t) => <a href={withBase(t.href)} aria-current={t.match(path) ? 'page' : undefined}>{t.label}</a>)}
      </nav>
      <div class="tools">
        <button class="icon-btn" id="search-open" aria-label="Search (press /)">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /></svg>
        </button>
        <button class="icon-btn" id="theme-toggle" aria-label="Theme: auto">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="7.5" /><path d="M12 4.5a7.5 7.5 0 0 0 0 15z" fill="currentColor" /></svg>
        </button>
      </div>
    </div>
  </header>

  <main class="wrap" id="main" data-pagefind-body={indexed ? '' : undefined}>
    <slot />
  </main>

  <nav class="tabbar" aria-label="Main">
    {tabs.map((t) => (
      <a href={withBase(t.href)} aria-current={t.match(path) ? 'page' : undefined}>{t.label}</a>
    ))}
  </nav>

  <dialog id="search-dialog" aria-label="Search">
    <div class="search-head">
      <button class="icon-btn" id="search-close" aria-label="Close search"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
    </div>
    <div id="search"></div>
    <p class="muted search-note" id="search-note" hidden>Search is built at deploy time, so it isn't available in dev mode.</p>
  </dialog>

  <script>
    import { withBase } from '../lib/url';

    declare const PagefindUI: new (options: {
      element: string;
      showSubResults?: boolean;
      showImages?: boolean;
      resetStyles?: boolean;
      autofocus?: boolean;
    }) => unknown;

    const root = document.documentElement;
    const btn = document.getElementById('theme-toggle')!;
    const order = ['auto', 'light', 'dark'] as const;
    const read = () => (root.dataset.theme as 'light' | 'dark' | undefined) ?? 'auto';
    const label = () => btn.setAttribute('aria-label', `Theme: ${read()}`);
    label();
    btn.addEventListener('click', () => {
      const next = order[(order.indexOf(read()) + 1) % order.length];
      if (next === 'auto') delete root.dataset.theme; else root.dataset.theme = next;
      try { next === 'auto' ? localStorage.removeItem('ag:theme') : localStorage.setItem('ag:theme', next); } catch {}
      label();
      window.dispatchEvent(new CustomEvent('ag:theme'));
    });

    const dialog = document.getElementById('search-dialog') as HTMLDialogElement;
    let loaded = false;
    async function openSearch() {
      dialog.showModal();
      if (!loaded) {
        loaded = true;
        try {
          const css = document.createElement('link');
          css.rel = 'stylesheet'; css.href = withBase('/pagefind/pagefind-ui.css');
          document.head.appendChild(css);
          await new Promise<void>((res, rej) => {
            const s = document.createElement('script');
            s.src = withBase('/pagefind/pagefind-ui.js'); s.onload = () => res(); s.onerror = () => rej();
            document.head.appendChild(s);
          });
          new PagefindUI({ element: '#search', showSubResults: false, showImages: false, resetStyles: false, autofocus: true });
        } catch {
          document.getElementById('search-note')!.hidden = false;
        }
      }
      (dialog.querySelector('input') as HTMLInputElement | null)?.focus();
    }
    document.getElementById('search-open')!.addEventListener('click', openSearch);
    document.getElementById('search-close')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    document.addEventListener('keydown', (e) => {
      const el = e.target as HTMLElement;
      if (e.key === '/' && !dialog.open && !/INPUT|TEXTAREA|SELECT/.test(el.tagName)) { e.preventDefault(); openSearch(); }
    });
  </script>

  <style>
    .skip-link { position: absolute; left: var(--gutter); top: 8px; z-index: 50; padding: 10px 16px; background: var(--ink); color: var(--bg); font-weight: 700; transform: translateY(-200%); }
    .skip-link:focus { transform: none; }
    .site-header { position: sticky; top: 0; z-index: 20; background: var(--bg); border-bottom: 1px solid var(--line); }
    .bar { display: flex; align-items: center; gap: 32px; height: 60px; }
    .brand { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; font-weight: 700; font-size: 1rem; letter-spacing: -0.02em; white-space: nowrap; background: none; }
    .mark { width: 14px; height: 14px; background: var(--accent); transition: transform var(--m-out) var(--ease); }
    .brand:hover .mark { transform: rotate(45deg); transition-duration: var(--m-in); }
    .top-nav { display: none; gap: 28px; }
    .top-nav a { font-weight: 500; font-size: 0.95rem; padding: 10px 0; }
    .top-nav a[aria-current='page'] { background-size: 100% 2px; background-image: linear-gradient(var(--accent), var(--accent)); }
    .tools { margin-left: auto; margin-right: -12px; display: flex; gap: 0; }
    .icon-btn { width: 44px; height: 44px; display: grid; place-items: center; border: 0; background: none; color: var(--ink); cursor: pointer; transition: color var(--m-out) var(--ease), transform var(--m-out) var(--ease); }
    .icon-btn:hover { color: var(--accent); transition-duration: var(--m-in); }
    .icon-btn:active { transform: scale(0.94); transition-duration: var(--m-press); }

    .tabbar {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
      display: grid; grid-template-columns: repeat(5, 1fr);
      height: calc(var(--tabbar-h) + env(safe-area-inset-bottom));
      padding-bottom: env(safe-area-inset-bottom);
      background: var(--bg); border-top: 2px solid var(--rule);
    }
    .tabbar a { position: relative; display: grid; place-items: center; font-size: 0.8rem; font-weight: 500; color: var(--muted); background: none; }
    .tabbar a[aria-current='page'] { color: var(--ink); font-weight: 700; }
    .tabbar a[aria-current='page']::before { content: ''; position: absolute; top: -2px; left: 18%; right: 18%; height: 4px; background: var(--accent); }
    @media (min-width: 760px) {
      .top-nav { display: flex; }
      .tabbar { display: none; }
    }

    dialog {
      width: min(640px, calc(100vw - 24px)); max-height: min(80vh, 720px); margin: 12vh auto auto;
      border: 2px solid var(--rule); border-radius: 0; padding: 12px 20px 20px; background: var(--bg); color: var(--ink);
    }
    dialog::backdrop { background: rgb(0 0 0 / 0.4); }
    .search-head { display: flex; justify-content: flex-end; }
    .search-note { margin-top: 12px; font-size: 0.9rem; }
    :global(#search) {
      --pagefind-ui-scale: 0.9; --pagefind-ui-primary: var(--accent); --pagefind-ui-text: var(--ink);
      --pagefind-ui-background: var(--bg); --pagefind-ui-border: var(--rule); --pagefind-ui-tag: var(--surface);
      --pagefind-ui-border-width: 2px; --pagefind-ui-border-radius: 0px; --pagefind-ui-font: var(--font);
    }
  </style>
</body>
</html>
