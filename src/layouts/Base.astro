---
import '../styles/global.css';
import { withBase } from '../lib/url';

interface Props { title?: string; description?: string; indexed?: boolean }
const { title, description = 'A garden of Claude artifacts and the engineering vocabulary they taught me.', indexed = false } = Astro.props;
const pageTitle = title ? `${title} · artifact garden` : 'artifact garden';
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';

const tabs = [
  { href: '/', label: 'Home', icon: 'M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z', match: (p: string) => p === '/' },
  { href: '/artifacts', label: 'Artifacts', icon: 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z', match: (p: string) => p.startsWith('/artifacts') || p.startsWith('/a/') || p.startsWith('/topics') },
  { href: '/terms', label: 'Glossary', icon: 'M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3zM5 17a3 3 0 0 1 3-3h11', match: (p: string) => p.startsWith('/terms') },
  { href: '/review', label: 'Review', icon: 'M7 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM9 12l2 2 4-4', match: (p: string) => p.startsWith('/review') },
  { href: '/graph', label: 'Graph', icon: 'M6 6m-2.5 0a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0-5 0M18 8m-2.5 0a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0-5 0M10 18m-2.5 0a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0-5 0M8.3 7l7.4.8M7 8.3l2 7.4M16.5 10l-4.5 6', match: (p: string) => p.startsWith('/graph') },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#faf7f2" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#161513" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,600;1,6..72,500&display=swap" rel="stylesheet" />
  <script is:inline>
    try {
      const t = localStorage.getItem('ag:theme');
      if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
    } catch {}
  </script>
</head>
<body>
  <header class="site-header">
    <div class="wrap bar">
      <a class="brand" href={withBase('/')}><span class="leaf" aria-hidden="true">❦</span> artifact garden</a>
      <nav class="top-nav" aria-label="Main">
        {tabs.slice(1).map((t) => <a href={withBase(t.href)} aria-current={t.match(path) ? 'page' : undefined}>{t.label}</a>)}
      </nav>
      <div class="tools">
        <button class="icon-btn" id="search-open" aria-label="Search (press /)">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /></svg>
        </button>
        <button class="icon-btn" id="theme-toggle" aria-label="Theme: auto">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8" /><path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor" /></svg>
        </button>
      </div>
    </div>
  </header>

  <main class="wrap" data-pagefind-body={indexed ? '' : undefined}>
    <slot />
  </main>

  <nav class="tabbar" aria-label="Main">
    {tabs.map((t) => (
      <a href={withBase(t.href)} aria-current={t.match(path) ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={t.icon} /></svg>
        <span>{t.label}</span>
      </a>
    ))}
  </nav>

  <dialog id="search-dialog" aria-label="Search">
    <div class="search-head">
      <span class="eyebrow">Search artifacts & terms</span>
      <button class="icon-btn" id="search-close" aria-label="Close search">✕</button>
    </div>
    <div id="search"></div>
    <p class="muted search-note" id="search-note" hidden>Search is built at deploy time, so it isn't available in dev mode.</p>
  </dialog>

  <script>
    import { withBase } from '../lib/url';

    declare const PagefindUI: new (options: {
      element: string;
      showSubResults?: boolean;
      showImages?: boolean;
      resetStyles?: boolean;
      autofocus?: boolean;
    }) => unknown;

    const root = document.documentElement;
    const btn = document.getElementById('theme-toggle')!;
    const order = ['auto', 'light', 'dark'] as const;
    const read = () => (root.dataset.theme as 'light' | 'dark' | undefined) ?? 'auto';
    const label = () => btn.setAttribute('aria-label', `Theme: ${read()}`);
    label();
    btn.addEventListener('click', () => {
      const next = order[(order.indexOf(read()) + 1) % order.length];
      if (next === 'auto') delete root.dataset.theme; else root.dataset.theme = next;
      try { next === 'auto' ? localStorage.removeItem('ag:theme') : localStorage.setItem('ag:theme', next); } catch {}
      label();
      window.dispatchEvent(new CustomEvent('ag:theme'));
    });

    const dialog = document.getElementById('search-dialog') as HTMLDialogElement;
    let loaded = false;
    async function openSearch() {
      dialog.showModal();
      if (!loaded) {
        loaded = true;
        try {
          const css = document.createElement('link');
          css.rel = 'stylesheet'; css.href = withBase('/pagefind/pagefind-ui.css');
          document.head.appendChild(css);
          await new Promise<void>((res, rej) => {
            const s = document.createElement('script');
            s.src = withBase('/pagefind/pagefind-ui.js'); s.onload = () => res(); s.onerror = () => rej();
            document.head.appendChild(s);
          });
          new PagefindUI({ element: '#search', showSubResults: false, showImages: false, resetStyles: false, autofocus: true });
        } catch {
          document.getElementById('search-note')!.hidden = false;
        }
      }
      (dialog.querySelector('input') as HTMLInputElement | null)?.focus();
    }
    document.getElementById('search-open')!.addEventListener('click', openSearch);
    document.getElementById('search-close')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    document.addEventListener('keydown', (e) => {
      const el = e.target as HTMLElement;
      if (e.key === '/' && !dialog.open && !/INPUT|TEXTAREA|SELECT/.test(el.tagName)) { e.preventDefault(); openSearch(); }
    });
  </script>

  <style>
    .site-header { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
    .bar { display: flex; align-items: center; gap: 16px; height: 56px; }
    .brand { font: 600 1.15rem var(--serif); text-decoration: none; letter-spacing: -0.01em; white-space: nowrap; }
    .leaf { color: var(--accent); }
    .top-nav { display: none; gap: 4px; margin-left: 12px; }
    .top-nav a { text-decoration: none; color: var(--muted); padding: 6px 10px; border-radius: 8px; font-weight: 500; font-size: 0.94rem; }
    .top-nav a:hover { color: var(--ink); }
    .top-nav a[aria-current='page'] { color: var(--ink); background: var(--surface-2); }
    .tools { margin-left: auto; display: flex; gap: 4px; }
    .icon-btn { width: 40px; height: 40px; display: grid; place-items: center; border-radius: 10px; border: 0; background: none; color: var(--muted); cursor: pointer; font-size: 1rem; }
    .icon-btn:hover { color: var(--ink); background: var(--surface-2); }

    .tabbar {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
      display: grid; grid-template-columns: repeat(5, 1fr);
      height: calc(var(--tabbar-h) + env(safe-area-inset-bottom));
      padding-bottom: env(safe-area-inset-bottom);
      background: color-mix(in srgb, var(--surface) 92%, transparent); backdrop-filter: blur(12px);
      border-top: 1px solid var(--line);
    }
    .tabbar a { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; text-decoration: none; color: var(--muted); font-size: 0.7rem; font-weight: 500; }
    .tabbar a[aria-current='page'] { color: var(--accent); }
    @media (min-width: 760px) {
      .top-nav { display: flex; }
      .tabbar { display: none; }
    }

    dialog {
      width: min(640px, calc(100vw - 24px)); max-height: min(80vh, 720px); margin: 10vh auto auto;
      border: 1px solid var(--line); border-radius: 16px; padding: 16px; background: var(--surface); color: var(--ink);
    }
    dialog::backdrop { background: rgb(20 15 10 / 0.35); backdrop-filter: blur(2px); }
    .search-head { display: flex; justify-content: space-between; align-items: center; }
    .search-head .eyebrow { margin: 0; }
    .search-note { margin-top: 12px; font-size: 0.9rem; }
    :global(#search) {
      --pagefind-ui-scale: 0.9; --pagefind-ui-primary: var(--accent); --pagefind-ui-text: var(--ink);
      --pagefind-ui-background: var(--surface); --pagefind-ui-border: var(--line); --pagefind-ui-tag: var(--surface-2);
      --pagefind-ui-border-radius: 10px; --pagefind-ui-font: var(--sans);
    }
  </style>
</body>
</html>
