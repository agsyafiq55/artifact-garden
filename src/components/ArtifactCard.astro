---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';

interface Props { artifact: CollectionEntry<'artifacts'> }
const { artifact } = Astro.props;
const { title, summary, topic } = artifact.data;
---
<li class="artifact-card" data-topic={topic}>
  <a class="entry" href={withBase(`/a/${artifact.id}`)}>
    <span class="entry__title">{title}</span>
    <span class="entry__text">{summary}</span>
  </a>
</li>
