---
import Base from '../layouts/Base.astro';
import { getTerms } from '../lib/content';
import { TOPICS, type Topic } from '../lib/topics';
import { withBase } from '../lib/url';

const terms = await getTerms();
const cards = terms.map((t) => ({
  id: t.id,
  term: t.data.term,
  definition: t.data.definition,
  analogy: t.data.analogy,
  example: t.data.example,
  topic: t.data.topic,
  href: withBase(`/terms/${t.id}`),
}));
const usedTopics = [...new Set(terms.map((t) => t.data.topic))] as Topic[];
---
<Base title="Review">
  <div class="head">
    <h1>Review</h1>
    <label><span class="visually-hidden">Topic</span>
      <select id="f-topic">
        <option value="">All topics</option>
        {usedTopics.map((t) => <option value={t}>{TOPICS[t].label}</option>)}
      </select>
    </label>
  </div>

  <p class="left" id="stats"></p>

  <section id="deck" class="deck" aria-live="polite">
    <article class="flash" id="card" hidden>
      <h2 class="c-term" id="c-term"></h2>
      <div id="c-back" hidden>
        <p class="c-def" id="c-def"></p>
        <p class="c-analogy" id="c-analogy"></p>
        <p class="c-example" id="c-example"></p>
        <a class="c-link" id="c-link" href="#">Open the term</a>
      </div>
    </article>

    <button class="btn primary reveal" id="reveal" hidden>Show answer</button>
    <div class="grades" id="grades" hidden>
      <button class="btn g0" data-grade="Again">Again<small></small></button>
      <button class="btn g1" data-grade="Hard">Hard<small></small></button>
      <button class="btn g2" data-grade="Good">Good<small></small></button>
      <button class="btn g3" data-grade="Easy">Easy<small></small></button>
    </div>

    <div class="done" id="done" hidden>
      <h2>Nothing left for today</h2>
      <button class="btn small" id="more-new" hidden>Learn 5 more words</button>
    </div>
  </section>

  <details class="settings">
    <summary>Progress</summary>
    <p class="muted">Progress stays in this browser. Export it here and import it on your other device.</p>
    <div class="row">
      <button class="btn small" id="export">Export progress</button>
      <label class="btn small" for="import">Import progress</label>
      <input type="file" id="import" accept="application/json,.json" hidden />
    </div>
    <div class="row">
      <label>New cards per day
        <select id="per-day">
          {[5, 10, 15, 20, 30].map((n) => <option value={n}>{n}</option>)}
        </select>
      </label>
      <button class="btn small danger" id="reset">Reset progress</button>
    </div>
    <p class="muted small" id="settings-msg" role="status"></p>
  </details>

  <script type="application/json" id="cards-data" set:html={JSON.stringify(cards)} />
</Base>

<script>
  import { load, save, queue, grade, schedule, formatInterval, exportJson, mergeImport, reset, allowMoreNew, localDayKey, Grade, type Store } from '../lib/srs';

  type Card = { id: string; term: string; definition: string; analogy: string; example: string; topic: string; href: string };
  const cards: Card[] = JSON.parse(document.getElementById('cards-data')!.textContent!);
  const byId = new Map(cards.map((c) => [c.id, c]));
  const gradeOf = (b: HTMLElement) => Grade[b.dataset.grade as keyof typeof Grade];
  const GRADE_KEYS: Record<string, Grade> = { '1': Grade.Again, '2': Grade.Hard, '3': Grade.Good, '4': Grade.Easy };
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const topicSel = $<HTMLSelectElement>('f-topic');

  let store: Store = load();
  let session: string[] = [];
  let current: string | null = null;

  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const inline = (s: string) => esc(s).replace(/`([^`]+)`/g, '<code>$1</code>');
  const ids = () => cards.filter((c) => !topicSel.value || c.topic === topicSel.value).map((c) => c.id);

  function build() {
    const q = queue(store, ids());
    session = [...q.due, ...q.fresh];
    next();
  }

  function next() {
    const q = queue(store, ids());
    current = session.shift() ?? null;
    const left = session.length + (current ? 1 : 0);
    $('stats').textContent = left ? `${left} left` : '';
    const has = !!current;
    $('card').hidden = !has; $('reveal').hidden = !has; $('grades').hidden = true; $('c-back').hidden = true;
    $('done').hidden = has;
    if (!current) {
      const remaining = q.totalNew - q.fresh.length;
      $('more-new').hidden = remaining <= 0;
      return;
    }
    const c = byId.get(current)!;
    $('c-term').textContent = c.term;
    $('c-def').textContent = c.definition;
    $('c-analogy').textContent = c.analogy;
    $('c-example').innerHTML = inline(c.example);
    $<HTMLAnchorElement>('c-link').href = c.href;
    const isNew = !store.cards[current];
    $('card').classList.toggle('is-new', isNew);
    document.querySelectorAll<HTMLButtonElement>('#grades button').forEach((b) => {
      const g = gradeOf(b);
      b.querySelector('small')!.textContent = formatInterval(schedule(store.cards[current!], g));
    });
  }

  function reveal() {
    if (!current) return;
    $('c-back').hidden = false; $('reveal').hidden = true; $('grades').hidden = false;
    ($('grades').querySelector('.g2') as HTMLButtonElement).focus({ preventScroll: true });
  }

  function answer(g: Grade) {
    if (!current) return;
    grade(store, current, g);
    if (g === Grade.Again) session.push(current);
    next();
  }

  $('reveal').addEventListener('click', reveal);
  $('card').addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('a')) reveal(); });
  $('grades').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button'); if (b) answer(gradeOf(b));
  });
  document.addEventListener('keydown', (e) => {
    if ((e.target as HTMLElement).matches('input, select, textarea') || document.querySelector('dialog[open]')) return;
    if ((e.key === ' ' || e.key === 'Enter') && !$('reveal').hidden) { e.preventDefault(); reveal(); }
    else if (!$('grades').hidden && e.key in GRADE_KEYS) answer(GRADE_KEYS[e.key]);
  });
  topicSel.addEventListener('change', build);
  $('more-new').addEventListener('click', () => { allowMoreNew(store, 5); build(); });

  const msg = (s: string) => { $('settings-msg').textContent = s; };
  const perDay = $<HTMLSelectElement>('per-day');
  perDay.value = String(store.newPerDay);
  perDay.addEventListener('change', () => { store.newPerDay = Number(perDay.value); save(store); build(); });
  $('export').addEventListener('click', () => {
    const blob = new Blob([exportJson(store)], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `artifact-garden-progress-${localDayKey()}.json`;
    a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    msg('Progress exported.');
  });
  $<HTMLInputElement>('import').addEventListener('change', async (e) => {
    const f = (e.target as HTMLInputElement).files?.[0]; if (!f) return;
    try {
      const r = mergeImport(store, await f.text());
      msg(`Imported: ${r.added} new, ${r.updated} updated.`); build();
    } catch (err) { msg(`Import failed: ${(err as Error).message}`); }
    (e.target as HTMLInputElement).value = '';
  });
  $('reset').addEventListener('click', () => {
    if (!confirm('Erase all review progress on this device?')) return;
    reset(); store = load(); perDay.value = String(store.newPerDay); build(); msg('Progress reset.');
  });

  build();
</script>

<style>
  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .head h1 { margin: 0; }
  .left { min-height: 1.6em; font-size: 0.88rem; color: var(--faint); margin: 6px 0 28px; }
  .deck { display: grid; gap: 18px; max-width: 560px; margin: 0 auto; }
  .flash {
    min-height: 300px; padding: 40px 28px 32px; cursor: pointer;
    display: flex; flex-direction: column; align-items: flex-start;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-soft);
  }
  .flash.is-new .c-term::after { content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); margin-left: 10px; vertical-align: middle; }
  .c-term { font-size: clamp(1.7rem, 7vw, 2.3rem); color: var(--ink); margin: 0 0 8px; }
  #c-back { width: 100%; border-top: 1px solid var(--line); margin-top: 20px; padding-top: 24px; cursor: auto; }
  .c-def { font: 500 1.15rem/1.65 var(--serif); margin-bottom: 20px; }
  .c-analogy { font: italic 1rem/1.75 var(--serif); color: var(--muted); padding-left: 14px; border-left: 1px solid var(--accent); }
  .c-example { font-size: 0.93rem; }
  .c-link { font-size: 0.88rem; color: var(--muted); padding: 8px 0; display: inline-block; }
  .reveal { width: 100%; min-height: 52px; }
  .grades { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .grades .btn { flex-direction: column; gap: 0; padding: 10px 4px; min-height: 60px; font-size: 0.92rem; }
  .grades small { font: 400 0.72rem var(--mono); color: var(--faint); }
  .done { text-align: center; padding: 48px 20px; }
  .done h2 { margin: 0 0 20px; color: var(--ink); }
  .settings { max-width: 560px; margin: 64px auto 0; padding-top: 16px; border-top: 1px solid var(--line); }
  .settings summary { cursor: pointer; color: var(--muted); padding: 10px 0; }
  .settings p { font-size: 0.9rem; margin: 10px 0; }
  .row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 14px 0; }
  .row label:not(.btn) { display: flex; gap: 10px; align-items: center; font-size: 0.9rem; }
  .danger { color: var(--bad); margin-left: auto; }
  .small { font-size: 0.85rem; }
</style>
