---
import Base from '../layouts/Base.astro';
import { getTerms } from '../lib/content';
import { getTracks } from '../lib/tracks';
import { withBase } from '../lib/url';

const terms = await getTerms();
const cards = terms.map((t) => ({
  id: t.id,
  term: t.data.term,
  definition: t.data.definition,
  analogy: t.data.analogy,
  example: t.data.example,
  href: withBase(`/terms/${t.id}`),
}));

const [track] = await getTracks();
const onRoadmap = new Set<string>();
const topics: { id: string; title: string; ids: string[] }[] = [];
if (track) {
  for (const s of track.data.sections) {
    const ids = [...new Set(s.nodes.flatMap((n) => n.terms.map((r) => r.id)))];
    ids.forEach((id) => onRoadmap.add(id));
    if (ids.length) topics.push({ id: s.id, title: s.title, ids });
  }
}
const loose = terms.map((t) => t.id).filter((id) => !onRoadmap.has(id));
if (loose.length) topics.push({ id: 'unsorted', title: 'Not on the roadmap', ids: loose });
if (topics.length > 1) topics.unshift({ id: 'all', title: 'All terms', ids: terms.map((t) => t.id) });
const cardLabel = (n: number) => `${n} ${n === 1 ? 'card' : 'cards'}`;
---
<Base title="Review">
  <header class="page-head">
    <h1>Review</h1>
  </header>

  <section id="picker">
    <h2 class="pick-title">What do you want to revise?</h2>
    {topics.length === 0 && <p class="muted">No terms yet. They arrive with each artifact.</p>}
    <ol class="topics">
      {topics.map((t, i) => (
        <li>
          <button class="topic" data-topic={t.id}>
            <span class="topic__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="topic__label">{t.title}</span>
            <span class="topic__count">{cardLabel(t.ids.length)}</span>
          </button>
        </li>
      ))}
    </ol>
  </section>

  <section id="session" hidden>
    <div class="session-bar">
      <button class="btn small" id="change">Change topic</button>
      <p class="where"><span id="topic-name"></span> <span id="position"></span></p>
    </div>

    <div class="deck" aria-live="polite">
      <div class="flip" id="card" role="button" tabindex="0" aria-label="Flip the card" aria-pressed="false">
        <div class="flip__inner">
          <div class="face front">
            <h2 class="c-term" id="c-term"></h2>
          </div>
          <div class="face back" aria-hidden="true">
            <p class="c-term-small" id="c-term-back"></p>
            <p class="c-def" id="c-def"></p>
            <p class="c-analogy" id="c-analogy"></p>
            <p class="c-example" id="c-example"></p>
            <a class="c-link" id="c-link" href="#" tabindex="-1">Open the term</a>
          </div>
        </div>
      </div>

      <div class="controls">
        <button class="btn" id="prev">Previous</button>
        <button class="btn primary" id="flip">Flip card</button>
        <button class="btn" id="next">Next</button>
      </div>
    </div>
  </section>

  <script type="application/json" id="cards-data" set:html={JSON.stringify(cards)} />
  <script type="application/json" id="topics-data" set:html={JSON.stringify(topics)} />
</Base>

<script>
  type Card = { id: string; term: string; definition: string; analogy: string; example: string; href: string };
  type Topic = { id: string; title: string; ids: string[] };
  const cards: Card[] = JSON.parse(document.getElementById('cards-data')!.textContent!);
  const topics: Topic[] = JSON.parse(document.getElementById('topics-data')!.textContent!);
  const byId = new Map(cards.map((c) => [c.id, c]));
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

  let deck: Card[] = [];
  let index = 0;
  let flipped = false;

  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const inline = (s: string) => esc(s).replace(/`([^`]+)`/g, '<code>$1</code>');

  function setFlipped(v: boolean) {
    flipped = v;
    const card = $('card');
    card.classList.toggle('is-flipped', v);
    card.setAttribute('aria-pressed', String(v));
    card.querySelector('.front')!.setAttribute('aria-hidden', String(v));
    card.querySelector('.back')!.setAttribute('aria-hidden', String(!v));
    $<HTMLAnchorElement>('c-link').tabIndex = v ? 0 : -1;
    $('flip').textContent = v ? 'Flip back' : 'Flip card';
  }

  function show(i: number) {
    index = (i + deck.length) % deck.length;
    const c = deck[index];
    setFlipped(false);
    $('c-term').textContent = c.term;
    $('c-term-back').textContent = c.term;
    $('c-def').textContent = c.definition;
    $('c-analogy').textContent = c.analogy;
    $('c-example').innerHTML = inline(c.example);
    $<HTMLAnchorElement>('c-link').href = c.href;
    $('position').textContent = `${index + 1} of ${deck.length}`;
    const single = deck.length < 2;
    $<HTMLButtonElement>('prev').disabled = single;
    $<HTMLButtonElement>('next').disabled = single;
  }

  function start(id: string) {
    const topic = topics.find((t) => t.id === id);
    if (!topic) return;
    deck = topic.ids.map((t) => byId.get(t)!).filter(Boolean);
    $('topic-name').textContent = topic.title;
    $('picker').hidden = true;
    $('session').hidden = false;
    show(0);
    window.scrollTo({ top: 0 });
  }

  function back() {
    $('picker').hidden = false;
    $('session').hidden = true;
  }

  document.querySelectorAll<HTMLButtonElement>('.topic').forEach((b) => b.addEventListener('click', () => start(b.dataset.topic!)));
  $('change').addEventListener('click', back);
  $('flip').addEventListener('click', () => setFlipped(!flipped));
  $('prev').addEventListener('click', () => show(index - 1));
  $('next').addEventListener('click', () => show(index + 1));
  $('card').addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('a')) setFlipped(!flipped); });
  document.addEventListener('keydown', (e) => {
    if ($('session').hidden || document.querySelector('dialog[open]')) return;
    const el = e.target as HTMLElement;
    if (el.matches?.('input, select, textarea')) return;
    if ((e.key === ' ' || e.key === 'Enter') && !el.matches?.('button, a')) { e.preventDefault(); setFlipped(!flipped); }
    else if (e.key === 'ArrowRight') show(index + 1);
    else if (e.key === 'ArrowLeft') show(index - 1);
  });
</script>

<style>
  .pick-title { font-size: clamp(1.4rem, 5vw, 2rem); letter-spacing: -0.03em; margin: 28px 0 8px; }
  .topics { list-style: none; margin: 0; padding: 0; }
  .topics li + li { border-top: 1px solid var(--line); }
  .topic {
    width: 100%; display: grid; grid-template-columns: 2.6rem 1fr auto; align-items: baseline; gap: 12px;
    padding: 16px 0; min-height: 56px; border: 0; background: none; color: var(--ink); text-align: left; cursor: pointer;
    font: inherit; transition: transform var(--m-out) var(--ease);
  }
  .topic:hover { transform: translateY(-2px); transition-duration: var(--m-in); }
  .topic:hover .topic__label { color: var(--accent); }
  .topic:active { transform: scale(0.99); transition-duration: var(--m-press); }
  .topic__num { font-weight: 700; color: var(--accent); }
  .topic__label { font-size: clamp(1.2rem, 4.4vw, 1.6rem); font-weight: 700; letter-spacing: -0.025em; line-height: 1.2; transition: color var(--m-out) var(--ease); }
  .topic__count { font-size: 0.88rem; font-weight: 500; color: var(--muted); white-space: nowrap; }

  .session-bar { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin: 20px 0 24px; }
  .where { margin: 0; font-size: 0.95rem; }
  #topic-name { font-weight: 700; }
  #position { color: var(--muted); }

  .deck { display: grid; gap: 16px; max-width: 640px; }
  .flip { perspective: 1400px; cursor: pointer; outline-offset: 4px; }
  .flip__inner { display: grid; transform-style: preserve-3d; transition: transform 520ms var(--ease); }
  .flip.is-flipped .flip__inner { transform: rotateY(180deg); }
  .face {
    grid-area: 1 / 1; min-height: 320px; padding: 28px 24px;
    background: var(--bg); border: 2px solid var(--rule); border-top-width: 8px;
    backface-visibility: hidden; -webkit-backface-visibility: hidden;
    display: flex; flex-direction: column;
  }
  .front { justify-content: center; }
  .back { transform: rotateY(180deg); border-top-color: var(--accent); }
  .c-term { font-size: clamp(2rem, 8vw, 3.2rem); letter-spacing: -0.035em; margin: 0; }
  .c-term-small { font-weight: 700; color: var(--muted); margin: 0 0 14px; }
  .c-def { font-size: 1.25rem; font-weight: 500; letter-spacing: -0.015em; line-height: 1.3; margin-bottom: 20px; }
  .c-analogy { padding-top: 8px; border-top: 2px solid var(--accent); }
  .c-example { padding-top: 8px; border-top: 2px solid var(--rule); color: var(--muted); font-size: 0.95rem; }
  .c-link { font-size: 0.92rem; font-weight: 500; margin-top: auto; padding-top: 8px; min-height: 44px; display: inline-flex; align-items: center; width: fit-content; }
  .controls { display: grid; grid-template-columns: 1fr 1.4fr 1fr; gap: 0; }
  .controls .btn { min-height: 56px; }
  .controls .btn + .btn { border-left-width: 0; }
  .controls .btn.primary + .btn { border-left-width: 2px; }
  .controls .btn:disabled { opacity: 0.35; cursor: not-allowed; transform: none; }
  @media (prefers-reduced-motion: reduce) { .flip__inner { transition: none; } }
</style>
