---
import Base from '../layouts/Base.astro';
import ArtifactCard from '../components/ArtifactCard.astro';
import { getArtifacts, getTerms } from '../lib/content';
import { withBase } from '../lib/url';

const artifacts = await getArtifacts();
const terms = await getTerms();
const recentTerms = [...terms].sort((a, b) => b.data.added.getTime() - a.data.added.getTime()).slice(0, 12);
const ids = terms.map((t) => t.id);
---
<Base>
  <section class="hero" data-enter>
    <h1>Things I've learned, one artifact at a time.</h1>
    <a class="due" href={withBase('/review')} id="review-cta" data-ids={JSON.stringify(ids)}>
      <span id="due-text">Review today's cards</span>
    </a>
  </section>

  <section class="row">
    <h2 class="row__label">Latest</h2>
    <div class="row__body">
      <ul class="list">{artifacts.slice(0, 6).map((a) => <ArtifactCard artifact={a} />)}</ul>
      {artifacts.length > 6 && <p class="more"><a href={withBase('/artifacts')}>All {artifacts.length} artifacts</a></p>}
    </div>
  </section>

  <section class="row">
    <h2 class="row__label">New terms</h2>
    <div class="row__body">
      <ul class="words">{recentTerms.map((t) => <li><a href={withBase(`/terms/${t.id}`)}>{t.data.term}</a></li>)}</ul>
    </div>
  </section>
</Base>

<script>
  import { load, queue } from '../lib/srs';
  const el = document.getElementById('review-cta')!;
  const ids: string[] = JSON.parse(el.dataset.ids!);
  const q = queue(load(), ids);
  const n = q.due.length + q.fresh.length;
  document.getElementById('due-text')!.textContent =
    n === 0 ? 'Nothing to review today' : `${n} ${n === 1 ? 'card' : 'cards'} to review today`;
</script>

<style>
  .hero { padding: 6vh 0 10vh; }
  .hero h1 { font-size: clamp(2.9rem, 11vw, 7rem); max-width: 11ch; margin-bottom: 40px; }
  .due { font-size: 1.15rem; font-weight: 700; color: var(--accent); padding: 8px 0; display: inline-block; }
  .more { margin-top: 20px; font-weight: 500; }
</style>
