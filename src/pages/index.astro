---
import Base from '../layouts/Base.astro';
import ArtifactCard from '../components/ArtifactCard.astro';
import { getArtifacts, getTerms } from '../lib/content';
import { withBase } from '../lib/url';
import { getTracks, nextNodes, trackHref } from '../lib/tracks';

const artifacts = await getArtifacts();
const terms = await getTerms();
const recentTerms = [...terms].sort((a, b) => b.data.added.getTime() - a.data.added.getTime()).slice(0, 12);
const [track] = await getTracks();
const next = track ? nextNodes(track, 1)[0] : undefined;
---
<Base>
  <header class="intro">
    <h1>A collection of Claude artifacts for learning software engineering concepts.</h1>
    {track && next && (
      <a class="next" href={trackHref(track, next.id)}>Next on the {track.data.title} roadmap: <strong>{next.title}</strong></a>
    )}
  </header>

  <section class="row">
    <h2 class="row__label">Latest</h2>
    <div class="row__body">
      <ul class="list">{artifacts.slice(0, 6).map((a) => <ArtifactCard artifact={a} />)}</ul>
      {artifacts.length > 6 && <p class="more"><a href={withBase('/materials')}>All materials</a></p>}
    </div>
  </section>

  <section class="row">
    <h2 class="row__label">New terms</h2>
    <div class="row__body">
      <ul class="words">{recentTerms.map((t) => <li><a href={withBase(`/terms/${t.id}`)}>{t.data.term}</a></li>)}</ul>
    </div>
  </section>
</Base>


<style>
  .intro { padding-bottom: 8px; }
  .intro h1 { font-size: 1.25rem; font-weight: 500; letter-spacing: -0.01em; line-height: 1.4; max-width: 36ch; margin-bottom: 16px; }
  .next { display: block; width: fit-content; padding: 11px 0; line-height: 1.4; }
  .more { margin-top: 20px; font-weight: 500; }
</style>
