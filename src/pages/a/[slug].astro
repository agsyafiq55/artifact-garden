---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TopicBadge from '../../components/TopicBadge.astro';
import { getArtifacts, getTerms, fmtDate, type Artifact } from '../../lib/content';
import { u } from '../../lib/url';

export async function getStaticPaths() {
  const artifacts = await getArtifacts();
  return artifacts.map((artifact) => ({ params: { slug: artifact.id }, props: { artifact } }));
}

const { artifact } = Astro.props as { artifact: Artifact };
const { title, summary, topic, tags, created, prompt } = artifact.data;
const allTerms = await getTerms();
const terms = artifact.data.terms.map((r) => allTerms.find((t) => t.id === r.id)).filter((t) => !!t);
const { Content } = await render(artifact);
const src = u(`/artifacts/${artifact.id}.html`);
---
<Base title={title} description={summary} indexed>
  <p class="eyebrow"><a href={u('/artifacts')}>Artifacts</a></p>
  <h1>{title}</h1>
  <p class="lede">{summary}</p>
  <div class="meta" data-pagefind-ignore>
    <TopicBadge topic={topic} />
    <span class="muted">{fmtDate(created)}</span>
    {tags.map((t) => <a class="tag" href={u(`/artifacts?tag=${encodeURIComponent(t)}`)}>{t}</a>)}
  </div>

  <div class="frame-wrap" data-pagefind-ignore>
    <iframe id="artifact" title={title} data-src={src} sandbox="allow-scripts allow-popups" loading="lazy"></iframe>
    <div class="frame-bar">
      <button class="btn small" id="taller" type="button">Taller</button>
      <a class="btn small" href={src} target="_blank" rel="noopener">Open full screen ↗</a>
    </div>
  </div>

  {terms.length > 0 && (
    <section>
      <h2>Terms from this artifact</h2>
      <div class="grid two">
        {terms.map((t) => (
          <a class="card term" href={u(`/terms/${t.id}`)}>
            <h3>{t.data.term}</h3>
            <p class="muted">{t.data.definition}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="notes">
    <h2>Notes</h2>
    <div class="prose"><Content /></div>
    {prompt && <p class="prompt"><span class="eyebrow">Prompt</span>{prompt}</p>}
  </section>
</Base>

<script>
  const frame = document.getElementById('artifact') as HTMLIFrameElement;
  const base = frame.dataset.src!;
  const theme = () => {
    const t = document.documentElement.dataset.theme;
    if (t === 'light' || t === 'dark') return t;
    return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  };
  const sync = () => { const next = `${base}?theme=${theme()}`; if (!frame.src.endsWith(next)) frame.src = next; };
  sync();
  window.addEventListener('ag:theme', sync);
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', sync);
  document.getElementById('taller')!.addEventListener('click', () => {
    frame.style.height = `${frame.getBoundingClientRect().height + 300}px`;
  });
</script>

<style>
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; font-size: 0.85rem; margin: 4px 0 20px; }
  .frame-wrap { margin: 0 calc(-1 * var(--gutter)); }
  @media (min-width: 760px) { .frame-wrap { margin: 0; } }
  iframe {
    display: block; width: 100%; height: min(78vh, 900px); min-height: 520px;
    border: 1px solid var(--line); border-left: 0; border-right: 0; background: var(--bg);
  }
  @media (min-width: 760px) { iframe { border: 1px solid var(--line); border-radius: var(--radius); } }
  .frame-bar { display: flex; justify-content: flex-end; gap: 8px; padding: 10px var(--gutter) 0; }
  @media (min-width: 760px) { .frame-bar { padding-inline: 0; } }
  .term { text-decoration: none; }
  .term:hover { color: inherit; border-color: var(--accent); }
  .term p { margin: 4px 0 0; font-size: 0.92rem; }
  .prompt { margin-top: 20px; padding: 12px 14px; border-left: 3px solid var(--line); color: var(--muted); font-style: italic; font-family: var(--serif); font-size: 1.05rem; }
  .prompt .eyebrow { display: block; font-style: normal; margin-bottom: 4px; }
</style>
