---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getArtifacts, getTerms, type Artifact } from '../../lib/content';
import { withBase } from '../../lib/url';
import { nodeForArtifact, trackHref } from '../../lib/tracks';

export async function getStaticPaths() {
  const artifacts = await getArtifacts();
  return artifacts.map((artifact) => ({ params: { slug: artifact.id }, props: { artifact } }));
}

const { artifact } = Astro.props as { artifact: Artifact };
const { title, summary } = artifact.data;
const allTerms = await getTerms();
const terms = artifact.data.terms.map((r) => allTerms.find((t) => t.id === r.id)).filter((t) => !!t);
const { Content } = await render(artifact);
const src = withBase(`/artifacts/${artifact.id}.html`);
const place = await nodeForArtifact(artifact.id);
---
<Base title={title} description={summary} indexed>
  <header class="page-head">
    <h1>{title}</h1>
    <p class="lede">{summary}</p>
    {place && <a class="place" href={trackHref(place.track, place.node.id)}>{place.track.data.title} roadmap, {place.node.section}</a>}
  </header>

  <div class="frame-wrap" data-pagefind-ignore>
    <iframe id="artifact" title={title} data-src={src} sandbox="allow-scripts allow-popups" loading="lazy"></iframe>
    <a class="full" href={src} target="_blank" rel="noopener">Open full screen</a>
  </div>

  <section class="row">
    <h2 class="row__label">Notes</h2>
    <div class="row__body prose"><Content /></div>
  </section>

  {terms.length > 0 && (
    <section class="row">
      <h2 class="row__label">Terms</h2>
      <div class="row__body">
        <ul class="list">
          {terms.map((t) => (
            <li>
              <a class="entry" href={withBase(`/terms/${t.id}`)}>
                <span class="entry__title">{t.data.term}</span>
                <span class="entry__text">{t.data.definition}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>

<script>
  const frame = document.getElementById('artifact') as HTMLIFrameElement;
  const base = frame.dataset.src!;
  const theme = () => {
    const t = document.documentElement.dataset.theme;
    if (t === 'light' || t === 'dark') return t;
    return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  };
  const sync = () => { const next = `${base}?theme=${theme()}`; if (!frame.src.endsWith(next)) frame.src = next; };
  sync();
  window.addEventListener('ag:theme', sync);
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', sync);
</script>

<style>
  .page-head h1 { max-width: 18ch; }
  .place { display: inline-flex; align-items: center; min-height: 44px; margin-top: 12px; font-weight: 700; color: var(--accent); }
  .lede { font-size: 1.2rem; line-height: 1.4; max-width: 46ch; margin: 20px 0 0; }
  .frame-wrap { margin: 32px calc(-1 * var(--gutter)) 0; }
  @media (min-width: 760px) { .frame-wrap { margin-inline: 0; } }
  iframe { display: block; width: 100%; height: min(80vh, 920px); min-height: 540px; border: 0; border-block: 2px solid var(--rule); background: var(--bg); }
  @media (min-width: 760px) { iframe { border: 2px solid var(--rule); } }
  .frame-wrap:focus-within iframe, iframe:focus { outline: 3px solid var(--accent); outline-offset: -3px; }
  .full { display: inline-flex; align-items: center; min-height: 44px; margin: 8px var(--gutter) 0; font-weight: 500; font-size: 0.92rem; }
  @media (min-width: 760px) { .full { margin-inline: 0; } }
</style>
