---
import Base from '../../layouts/Base.astro';
import ArtifactCard from '../../components/ArtifactCard.astro';
import { getArtifacts, getTerms } from '../../lib/content';
import { TOPICS, TOPIC_IDS, type Topic } from '../../lib/topics';
import { withBase } from '../../lib/url';

export function getStaticPaths() {
  return TOPIC_IDS.map((topic) => ({ params: { topic } }));
}

const topic = Astro.params.topic as Topic;
const { label, hue } = TOPICS[topic];
const artifacts = (await getArtifacts()).filter((a) => a.data.topic === topic);
const terms = (await getTerms()).filter((t) => t.data.topic === topic);
---
<Base title={label}>
  <p class="eyebrow"><a href={withBase('/artifacts')}>Topic</a></p>
  <h1 style={`--hue:${hue}`} class="title">{label}</h1>
  <p class="lede">{artifacts.length} artifact{artifacts.length === 1 ? '' : 's'} · {terms.length} term{terms.length === 1 ? '' : 's'}</p>

  {artifacts.length > 0 && (<>
    <h2>Artifacts</h2>
    <div class="grid two">{artifacts.map((a) => <ArtifactCard artifact={a} />)}</div>
  </>)}

  {terms.length > 0 && (<>
    <h2>Terms</h2>
    <ul class="chips">{terms.map((t) => <li><a class="chip" href={withBase(`/terms/${t.id}`)}>{t.data.term}</a></li>)}</ul>
  </>)}

  {artifacts.length + terms.length === 0 && <p class="muted">Nothing here yet.</p>}
</Base>

<style>
  .title { text-decoration: underline; text-decoration-color: hsl(var(--hue) var(--topic-s) var(--topic-l)); text-decoration-thickness: 4px; text-underline-offset: 8px; }
</style>
