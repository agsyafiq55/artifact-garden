---
import Base from '../../layouts/Base.astro';
import { getTerms } from '../../lib/content';
import { TOPICS, type Topic } from '../../lib/topics';
import { withBase } from '../../lib/url';

const terms = await getTerms();
const usedTopics = [...new Set(terms.map((t) => t.data.topic))] as Topic[];
const letter = (s: string) => (/[a-z]/i.test(s[0]) ? s[0].toUpperCase() : '#');
const groups = new Map<string, typeof terms>();
for (const t of terms) {
  const l = letter(t.data.term);
  if (!groups.has(l)) groups.set(l, []);
  groups.get(l)!.push(t);
}
---
<Base title="Glossary">
  <h1>Glossary</h1>

  <div class="filters">
    <label class="grow"><span class="visually-hidden">Filter terms</span>
      <input type="search" id="q" placeholder="Filter" autocomplete="off" />
    </label>
    <label><span class="visually-hidden">Topic</span>
      <select id="f-topic">
        <option value="">All topics</option>
        {usedTopics.map((t) => <option value={t}>{TOPICS[t].label}</option>)}
      </select>
    </label>
  </div>

  {[...groups.entries()].map(([l, list]) => (
    <section class="group">
      <h2 class="letter">{l}</h2>
      <ul class="list">
        {list.map((t) => (
          <li data-topic={t.data.topic} data-text={[t.data.term, ...t.data.aka, t.data.definition].join(' ').toLowerCase()}>
            <a class="entry" href={withBase(`/terms/${t.id}`)}>
              <span class="entry__title">{t.data.term}</span>
              <span class="entry__text">{t.data.definition}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <p class="muted" id="none" hidden>No terms match.</p>
</Base>

<script>
  const q = document.getElementById('q') as HTMLInputElement;
  const topic = document.getElementById('f-topic') as HTMLSelectElement;
  const items = [...document.querySelectorAll<HTMLElement>('.group li')];
  function apply() {
    const s = q.value.trim().toLowerCase();
    let n = 0;
    for (const li of items) {
      const ok = (!s || li.dataset.text!.includes(s)) && (!topic.value || li.dataset.topic === topic.value);
      li.hidden = !ok; if (ok) n++;
    }
    document.querySelectorAll<HTMLElement>('.group').forEach((g) => { g.hidden = !g.querySelector('li:not([hidden])'); });
    document.getElementById('none')!.hidden = n > 0;
  }
  q.addEventListener('input', apply); topic.addEventListener('change', apply);
</script>

<style>
  .filters { display: flex; gap: 20px; margin: 8px 0 16px; }
  .grow { flex: 1; }
  .grow input { width: 100%; }
  .letter { font-size: 1rem; color: var(--accent); margin: 2.6rem 0 0.4rem; }
</style>
