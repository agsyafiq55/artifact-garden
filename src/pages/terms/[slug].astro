---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getTerms, getArtifactsByTermId, backlinks, type Term } from '../../lib/content';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const terms = await getTerms();
  return terms.map((term) => ({ params: { slug: term.id }, props: { term } }));
}

const { term } = Astro.props as { term: Term };
const d = term.data;
const all = await getTerms();
const byId = new Map(all.map((t) => [t.id, t]));
const back = backlinks(all, term.id);
const relatedIds = [...new Set([...d.related.map((r) => r.id), ...back.related])].filter((id) => id !== term.id);
const contrastIds = [...new Set([...d.contrasts.map((r) => r.id), ...back.contrasts])].filter((id) => id !== term.id);
const sources = (await getArtifactsByTermId()).get(term.id) ?? [];
const { Content } = await render(term);
const hasBody = !!term.body?.trim();
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const inlineCode = (s: string) => esc(s).replace(/`([^`]+)`/g, '<code>$1</code>');
---
<Base title={d.term} description={d.definition} indexed>
  <header class="page-head">
    <h1>{d.term}</h1>
    {d.aka.length > 0 && <p class="aka">also {d.aka.join(', ')}</p>}
  </header>

  <section class="row first">
    <div class="row__body">
      <p class="definition">{d.definition}</p>
      <div class="pair">
        <p class="analogy">{d.analogy}</p>
        <p class="example" set:html={inlineCode(d.example)} />
      </div>
      {hasBody && <div class="prose body"><Content /></div>}
    </div>
  </section>

  {relatedIds.length > 0 && (
    <section class="row" data-pagefind-ignore>
      <h2 class="row__label">Related</h2>
      <ul class="row__body words">{relatedIds.map((id) => byId.get(id) && <li><a href={withBase(`/terms/${id}`)}>{byId.get(id)!.data.term}</a></li>)}</ul>
    </section>
  )}
  {contrastIds.length > 0 && (
    <section class="row" data-pagefind-ignore>
      <h2 class="row__label">Often confused with</h2>
      <ul class="row__body words">{contrastIds.map((id) => byId.get(id) && <li><a class="contrast" href={withBase(`/terms/${id}`)}>{byId.get(id)!.data.term}</a></li>)}</ul>
    </section>
  )}
  {sources.length > 0 && (
    <section class="row" data-pagefind-ignore>
      <h2 class="row__label">Learned from</h2>
      <ul class="row__body words">{sources.map((a) => <li><a href={withBase(`/a/${a.id}`)}>{a.data.title}</a></li>)}</ul>
    </section>
  )}
</Base>

<style>
  .aka { color: var(--muted); font-size: 1.05rem; margin: 14px 0 0; }
  .row.first { border-top: 0; margin-top: 8px; }
  .definition { font-size: clamp(1.45rem, 4.4vw, 2.1rem); font-weight: 500; letter-spacing: -0.02em; line-height: 1.2; max-width: 26ch; margin: 0 0 36px; }
  .pair { display: grid; gap: 20px; }
  @media (min-width: 760px) { .pair { grid-template-columns: 1fr 1fr; gap: var(--col-gap); } }
  .analogy, .example { margin: 0; font-size: 1rem; }
  .analogy { padding-top: 10px; border-top: 2px solid var(--accent); }
  .example { padding-top: 10px; border-top: 2px solid var(--rule); color: var(--muted); }
  .body { margin-top: 32px; }
</style>
