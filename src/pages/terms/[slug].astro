---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getTerms, getArtifactsByTermId, backlinks, type Term } from '../../lib/content';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const terms = await getTerms();
  return terms.map((term) => ({ params: { slug: term.id }, props: { term } }));
}

const { term } = Astro.props as { term: Term };
const d = term.data;
const all = await getTerms();
const byId = new Map(all.map((t) => [t.id, t]));
const back = backlinks(all, term.id);
const relatedIds = [...new Set([...d.related.map((r) => r.id), ...back.related])].filter((id) => id !== term.id);
const contrastIds = [...new Set([...d.contrasts.map((r) => r.id), ...back.contrasts])].filter((id) => id !== term.id);
const sources = (await getArtifactsByTermId()).get(term.id) ?? [];
const { Content } = await render(term);
const hasBody = !!term.body?.trim();
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const inlineCode = (s: string) => esc(s).replace(/`([^`]+)`/g, '<code>$1</code>');
---
<Base title={d.term} description={d.definition} indexed>
  <h1>{d.term}</h1>
  {d.aka.length > 0 && <p class="aka">also {d.aka.join(', ')}</p>}

  <p class="definition">{d.definition}</p>
  <p class="analogy">{d.analogy}</p>
  <p class="example" set:html={inlineCode(d.example)} />

  {hasBody && <section class="prose body"><Content /></section>}

  {relatedIds.length > 0 && (
    <section data-pagefind-ignore>
      <h2>Related</h2>
      <ul class="words">{relatedIds.map((id) => byId.get(id) && <li><a href={withBase(`/terms/${id}`)}>{byId.get(id)!.data.term}</a></li>)}</ul>
    </section>
  )}
  {contrastIds.length > 0 && (
    <section data-pagefind-ignore>
      <h2>Often confused with</h2>
      <ul class="words">{contrastIds.map((id) => byId.get(id) && <li><a class="contrast" href={withBase(`/terms/${id}`)}>{byId.get(id)!.data.term}</a></li>)}</ul>
    </section>
  )}
  {sources.length > 0 && (
    <section data-pagefind-ignore>
      <h2>Learned from</h2>
      <ul class="words">{sources.map((a) => <li><a href={withBase(`/a/${a.id}`)}>{a.data.title}</a></li>)}</ul>
    </section>
  )}
</Base>

<style>
  h1 { margin-bottom: 0.2em; }
  .aka { color: var(--faint); font-style: italic; margin: 0; }
  .definition { font: 500 clamp(1.3rem, 4.6vw, 1.65rem)/1.6 var(--serif); margin: 36px 0 32px; max-width: 34ch; }
  .analogy { font: 400 1.08rem/1.8 var(--serif); font-style: italic; color: var(--muted); max-width: 48ch; padding-left: 18px; border-left: 1px solid var(--accent); }
  .example { font-size: 0.98rem; max-width: 56ch; margin-top: 28px; }
  .body { margin-top: 32px; }
</style>
