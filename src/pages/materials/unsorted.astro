---
import Base from '../../layouts/Base.astro';
import ArtifactCard from '../../components/ArtifactCard.astro';
import Crumbs from '../../components/Crumbs.astro';
import { artifactTree } from '../../lib/tracks';
import { withBase } from '../../lib/url';

const { unsorted } = await artifactTree();
---
<Base title="Not on a roadmap">
  <header class="page-head">
    <Crumbs trail={[{ label: 'Materials', href: withBase('/materials') }]} />
    <h1>Not on a roadmap</h1>
  </header>
  {unsorted.length > 0
    ? <ul class="list body-list">{unsorted.map((a) => <ArtifactCard artifact={a} />)}</ul>
    : <p class="muted body-list">Every artifact is on a roadmap.</p>}
</Base>

<style>
  .body-list { margin-top: 28px; }
</style>
