---
import Base from '../../layouts/Base.astro';
import CategoryList from '../../components/CategoryList.astro';
import { artifactTree, countLabel, UNSORTED } from '../../lib/tracks';
import { withBase } from '../../lib/url';

const { tracks, unsorted, total } = await artifactTree();
const items = [
  ...tracks.map((t) => ({
    label: t.track.data.title,
    href: withBase(`/artifacts/${t.track.id}`),
    count: countLabel(t.sections.reduce((n, s) => n + s.concepts.reduce((m, c) => m + c.artifacts.length, 0), 0)),
  })),
  ...(unsorted.length ? [{ label: 'Unsorted', href: withBase(`/artifacts/${UNSORTED}`), count: countLabel(unsorted.length) }] : []),
];
---
<Base title="Artifacts">
  <header class="page-head head-split">
    <h1>Artifacts</h1>
    {total > 0 && <a class="all" href={withBase('/artifacts/all')}>All {countLabel(total)}</a>}
  </header>
  {items.length > 0 ? <CategoryList items={items} /> : <p class="muted empty">No artifacts yet.</p>}
</Base>

<style>
  .head-split { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; }
  .all { display: inline-flex; align-items: center; min-height: 44px; font-weight: 700; }
  .empty { margin-top: 28px; }
</style>
