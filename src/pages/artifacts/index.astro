---
import Base from '../../layouts/Base.astro';
import ArtifactCard from '../../components/ArtifactCard.astro';
import { getArtifacts } from '../../lib/content';
import { TOPICS, type Topic } from '../../lib/topics';

const artifacts = await getArtifacts();
const usedTopics = [...new Set(artifacts.map((a) => a.data.topic))] as Topic[];
---
<Base title="Artifacts">
  <div class="head">
    <h1>Artifacts</h1>
    {usedTopics.length > 1 && (
      <label><span class="visually-hidden">Topic</span>
        <select id="f-topic">
          <option value="">All topics</option>
          {usedTopics.map((t) => <option value={t}>{TOPICS[t].label}</option>)}
        </select>
      </label>
    )}
  </div>

  <ul class="list" id="list">
    {artifacts.map((a) => <ArtifactCard artifact={a} />)}
  </ul>
</Base>

<script>
  const topic = document.getElementById('f-topic') as HTMLSelectElement | null;
  topic?.addEventListener('change', () => {
    for (const c of document.querySelectorAll<HTMLElement>('#list .artifact-card')) {
      c.hidden = !!topic.value && c.dataset.topic !== topic.value;
    }
  });
</script>

<style>
  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; margin-bottom: 12px; }
  .head h1 { margin: 0; }
</style>
