---
import Base from '../../layouts/Base.astro';
import { getTracks, nodeStatus, nextNodes, trackProgress, type Track } from '../../lib/tracks';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const tracks = await getTracks();
  return tracks.map((track) => ({ params: { slug: track.id }, props: { track } }));
}

const { track } = Astro.props as { track: Track };
const { title, summary, sections } = track.data;
const next = nextNodes(track, 1)[0];
const { done, total } = trackProgress(track);
const statusText = { 'has-artifact': 'Artifact', 'has-terms': 'Terms', 'not-started': '' } as const;
const href = (n: (typeof sections)[number]['nodes'][number]) =>
  n.artifacts[0] ? withBase(`/a/${n.artifacts[0].id}`) : n.terms[0] ? withBase(`/terms/${n.terms[0].id}`) : null;
---
<Base title={`${title} roadmap`} description={summary}>
  <header class="page-head">
    <h1>{title}</h1>
    <p class="lede">{summary}</p>
    <p class="count"><strong>{done}</strong> of {total} core subjects have an artifact</p>
  </header>

  {sections.map((s, i) => (
    <section class="row">
      <h2 class="row__label"><span class="num">{String(i + 1).padStart(2, '0')}</span>{s.title}</h2>
      <ol class="row__body nodes">
        {s.nodes.map((n) => {
          const status = nodeStatus(n);
          const link = href(n);
          return (
            <li
              id={n.id}
              class:list={['node', n.level, status, { next: next?.id === n.id }]}
              data-artifact={n.artifacts.length > 0 ? '1' : undefined}
              data-terms={n.terms.map((t) => t.id).join(' ')}
            >
              {link ? <a class="node__title" href={link}>{n.title}</a> : <span class="node__title">{n.title}</span>}
              <span class="node__status">{next?.id === n.id ? 'Next' : statusText[status]}</span>
            </li>
          );
        })}
      </ol>
    </section>
  ))}

  <p class="credit">Written in our own words. For the original Backend roadmap, see <a href="https://roadmap.sh">roadmap.sh</a>.</p>
</Base>

<script>
  import { load } from '../../lib/srs';
  const cards = load().cards;
  for (const li of document.querySelectorAll<HTMLElement>('.node[data-artifact]')) {
    const terms = (li.dataset.terms ?? '').split(' ').filter(Boolean);
    if (terms.length && terms.every((t) => (cards[t]?.interval ?? 0) >= 7)) {
      li.classList.add('learned');
      li.querySelector('.node__status')!.textContent = 'Learned';
    }
  }
</script>

<style>
  .lede { font-size: 1.2rem; line-height: 1.4; max-width: 44ch; margin: 20px 0 0; }
  .count { margin: 16px 0 0; color: var(--muted); }
  .count strong { color: var(--ink); }
  .num { display: block; font-size: 2.2rem; letter-spacing: -0.04em; line-height: 1; color: var(--accent); margin-bottom: 6px; }
  .nodes { list-style: none; margin: 0; padding: 0; }
  .node { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; min-height: 44px; padding: 10px 0; scroll-margin-top: 80px; }
  .node + .node { border-top: 1px solid var(--line); }
  .node__title { font-size: 1.1rem; font-weight: 500; }
  a.node__title { font-weight: 700; }
  .node__status { flex: none; font-size: 0.82rem; font-weight: 700; color: var(--muted); }
  .node.extra .node__title { color: var(--faint); font-weight: 400; }
  .node.has-artifact .node__status, .node.learned .node__status { color: var(--ink); }
  .node.learned .node__title::before { content: ''; display: inline-block; width: 10px; height: 10px; background: var(--ink); margin-right: 10px; vertical-align: 1px; }
  .node.next { padding-left: 12px; border-left: 4px solid var(--accent); }
  .node.next .node__status { color: var(--accent); }
  .node:target { background: var(--surface); }
  .credit { margin-top: 64px; padding-top: 14px; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.9rem; }
</style>
